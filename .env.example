SERVER_PORT=8080
FRONTEND_PORT=8081
MONGO_PORT=27017

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=law_annotation
MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo:27017/${MONGO_INITDB_DATABASE}?authSource=admin

APP_INIT_ADMIN_ENABLED=true
APP_INIT_ADMIN_USERNAME=admin
APP_INIT_ADMIN_PASSWORD=admin123
APP_INIT_ADMIN_NAME=系统管理员

APP_DEMO_DATA_ENABLED=false
APP_DEMO_ANNOTATOR_USERNAME=annotator
APP_DEMO_ANNOTATOR_PASSWORD=annotator123

# Reserved application contract; the current Compose volume target is fixed to this path.
APP_UPLOAD_DIR=/app/data/uploads
APP_AUTH_SESSION_TIMEOUT=30m
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
