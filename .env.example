# Spring Boot backend
SERVER_PORT=8080

# Reserved for the final Docker/Nginx user entrypoint in PR24.
FRONTEND_PORT=8081

# MongoDB development container
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=law_admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=law_annotation

# The PR01 backend runs on the host, so localhost is used here.
# Replace all example credentials before any real deployment.
MONGODB_URI=mongodb://law_admin:change-me@localhost:27017/law_annotation?authSource=admin

# PR03 first administrator bootstrap. Replace the demonstration password.
APP_INIT_ADMIN_ENABLED=true
APP_INIT_ADMIN_USERNAME=admin
APP_INIT_ADMIN_PASSWORD=admin123
APP_INIT_ADMIN_NAME=系统管理员

# Local Vue development and server-side session settings.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_AUTH_SESSION_TIMEOUT=30m
